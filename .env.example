# Key of the "default" tenant (also used by the legacy routes). Required.
# Generate with: openssl rand -hex 32
WHATSAPP_API_TOKEN=

# Admin token for tenant provisioning (/api/v1/tenants). Optional: without it,
# /tenants routes return 503. Trust root: do NOT give it to clients; they get
# per-tenant keys instead.
# Generate with: openssl rand -hex 32
WHATSAPP_ADMIN_TOKEN=

# --- Panel (docker compose) ---
# Postgres password for the panel database (user/db are "panel").
PANEL_DB_PASSWORD=panel
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Generate with: openssl rand -hex 32
PANEL_ENCRYPTION_KEY=
# Root admin email (all tenants) and optional extra admins (comma-separated).
PRIMER_ADMIN=
PANEL_ADMIN_EMAILS=
# Google OAuth. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
