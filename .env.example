# Key of the "default" tenant (also used by the legacy routes). Required.
# Generate with: openssl rand -hex 32
WHATSAPP_API_TOKEN=

# Admin token for tenant provisioning (/api/v1/tenants). Optional: without it,
# /tenants routes return 503. Trust root: do NOT give it to clients; they get
# per-tenant keys instead.
# Generate with: openssl rand -hex 32
WHATSAPP_ADMIN_TOKEN=
