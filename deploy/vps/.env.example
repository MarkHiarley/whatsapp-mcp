# /root/whatsapp-panel/.env — never commit
PANEL_DB_PASSWORD=
PANEL_IMAGE=ghcr.io/markhiarley/whatsapp-panel:latest
PANEL_MIGRATE_IMAGE=ghcr.io/markhiarley/whatsapp-panel-migrate:latest
EDGE_NETWORK=default-app-network

# Public panel URL and Google OAuth
BETTER_AUTH_URL=https://panel.isaacvshiarley.cloud
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for tenant tokens at rest
PANEL_ENCRYPTION_KEY=

# Roles
PRIMER_ADMIN=
PANEL_ADMIN_EMAILS=

# Bridge (must be reachable from the VPS)
BRIDGE_URL=
BRIDGE_ADMIN_TOKEN=
# Optional Cloudflare Access service token for the bridge hostname
BRIDGE_CF_ACCESS_CLIENT_ID=
BRIDGE_CF_ACCESS_CLIENT_SECRET=
