# /root/whatsapp-panel/.env — never commit
PANEL_DB_PASSWORD=
PANEL_IMAGE=ghcr.io/markhiarley/whatsapp-mcp/panel:latest
PANEL_MIGRATE_IMAGE=ghcr.io/markhiarley/whatsapp-mcp/panel-migrate:latest
BRIDGE_IMAGE=ghcr.io/markhiarley/whatsapp-mcp/bridge:latest
EDGE_NETWORK=default-app-network

# WhatsApp bridge (must match the session in /root/whatsapp-mcp/data)
WHATSAPP_API_TOKEN=
WHATSAPP_ADMIN_TOKEN=

# Public panel URL and Google OAuth
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for tenant tokens at rest
PANEL_ENCRYPTION_KEY=

# Roles
PRIMER_ADMIN=hiarleycostamarley@gmail.com
PANEL_ADMIN_EMAILS=hiarleycostamarley@gmail.com,isaacnascimentosales@gmail.com
PANEL_ALLOWED_EMAILS=hiarleycostamarley@gmail.com,isaacnascimentosales@gmail.com
MCP_PUBLIC_URL=

# Bridge URL visible to the panel container
BRIDGE_URL=http://whatsapp-mcp:8080/api/v1
BRIDGE_ADMIN_TOKEN=
# Optional Cloudflare Access service token for a remote bridge
BRIDGE_CF_ACCESS_CLIENT_ID=
BRIDGE_CF_ACCESS_CLIENT_SECRET=

MCP_INTERNAL_URL=
MCP_INTERNAL_INTROSPECT_URL=
MCP_INTROSPECT_SECRET=
MCP_ALLOWED_HOSTS=