# Bridge API (server-side only; never expose these tokens to the browser)
BRIDGE_URL=http://127.0.0.1:8080/api/v1
BRIDGE_ADMIN_TOKEN=

# Panel database (Postgres)
DATABASE_URL=postgres://panel:panel@127.0.0.1:5433/panel

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# AES-256-GCM key for tenant tokens at rest (32 bytes hex)
# Generate with: openssl rand -hex 32
PANEL_ENCRYPTION_KEY=

# Roles: PRIMER_ADMIN is the root admin (all tenants). PANEL_ADMIN_EMAILS adds more.
PRIMER_ADMIN=
PANEL_ADMIN_EMAILS=

# Google OAuth (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
